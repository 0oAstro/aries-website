---
import '@/styles/global.css';
import { Navigation } from '@/components/Navigation';
import { TeamSection } from '@/components/TeamSection';
import Layout from '@/layouts/Layout.astro';

// Load team data
const teamData = await (await import('../lib/teamData.json')).default;

// Dynamically import all people images
const peopleImages = import.meta.glob('../images/people/*', { eager: true, import: 'default' });

function getImage(path: string): string {
  const cleanPath = path.replace(/^\.\.\//, '');
  for (const key in peopleImages) {
    if (key.endsWith(cleanPath.replace('src/', ''))) {
      const image = peopleImages[key];
      if (typeof image === 'string') {
        return image;
      } else if (image && typeof image === 'object' && 'src' in image) {
        return (image as any).src;
      }
    }
  }
  return '';
}

// Transform teamData to include resolved image paths
const transformedTeamData = {
  facultyHead: {
    ...teamData.facultyHead,
    photo: getImage(teamData.facultyHead.photo)
  },
  overallCoordinators: teamData.overallCoordinators.map((member: any) => ({
    ...member,
    photo: getImage(member.photo)
  })),
  coordinators: teamData.coordinators.map((member: any) => ({
    ...member,
    photo: getImage(member.photo)
  })),
  executives: teamData.executives
};
---

<Layout
  title="Meet Our Team | Aries AI Society IIT Delhi"
  description="Meet the brilliant minds behind Aries AI Society at IIT Delhi. Our diverse team of AI enthusiasts, researchers, and innovators are driving the future of artificial intelligence and machine learning."
  keywords="Aries team, AI society members, IIT Delhi students, machine learning experts, AI researchers, student leaders, tech innovators, artificial intelligence community"
  image="/images/people/family_photo.png"
  imageAlt="Aries AI Society team members at IIT Delhi"
  type="website"
>
  <Navigation client:load />
  <TeamSection client:load teamData={transformedTeamData} />
</Layout>
