---
import Layout from '@/layouts/Layout.astro';
import { Navigation } from '@/components/Navigation';
import '@/styles/global.css';

const notFoundSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Page Not Found - Aries AI Society",
  "description": "The page you're looking for doesn't exist. Explore other sections of Aries AI Society at IIT Delhi.",
  "url": "https://adorable-aries.vercel.app/404"
};
---

<Layout 
  title="404 - Page Not Found | Aries AI Society IIT Delhi"
  description="The page you're looking for doesn't exist. Return to Aries AI Society homepage to explore our AI and ML community at IIT Delhi."
  keywords="404 error, page not found, Aries AI Society, IIT Delhi"
  image="/arieslogo.svg"
  imageAlt="Aries AI Society - Page Not Found"
  type="website"
  schema={notFoundSchema}
>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Navigation client:load />
  
  <main id="main-content" class="error-container">
    <div class="error-content">
      <div class="error-code">404</div>
      <h1>Page Not Found</h1>
      <p>Oops! The page you're looking for doesn't exist or has been moved.</p>
      <div class="error-actions">
        <a href="/" class="primary-btn">Go Home</a>
        <a href="/events" class="secondary-btn">View Events</a>
        <a href="/projects" class="secondary-btn">See Projects</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #000000 0%, #1a1a1f 100%);
  }

  .error-content {
    max-width: 600px;
    width: 100%;
  }

  .error-code {
    font-size: 8rem;
    font-weight: bold;
    color: #8a4fff;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .error-content h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .error-content p {
    font-size: 1.2rem;
    color: #e0e0e0;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .primary-btn, .secondary-btn {
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .primary-btn {
    background: #8a4fff;
    color: white;
  }

  .primary-btn:hover {
    background: #7c3aed;
    transform: translateY(-2px);
  }

  .secondary-btn {
    background: transparent;
    color: #8a4fff;
    border-color: #8a4fff;
  }

  .secondary-btn:hover {
    background: #8a4fff;
    color: white;
  }

  @media (max-width: 768px) {
    .error-code {
      font-size: 6rem;
    }
    
    .error-content h1 {
      font-size: 2rem;
    }
    
    .error-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style> 