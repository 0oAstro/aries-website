---
import Layout from '@/layouts/Layout.astro';
import { Navigation } from '@/components/Navigation';
import { LegacySection } from '@/components/LegacySection';
import '@/styles/global.css';
---

<Layout 
  title="Our Legacy | Aries AI Society IIT Delhi - History & Achievements" 
  description="Discover the rich history and achievements of Aries AI Society at IIT Delhi. Learn about our journey, milestones, alumni success stories, and contributions to the AI community over the years."
  keywords="Aries legacy, AI society history, IIT Delhi achievements, alumni success, AI community impact, student organization history, machine learning milestones"
  image="/arieslogo.svg"
