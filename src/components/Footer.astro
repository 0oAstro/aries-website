---
// Footer component with mathematical grid and social links
import { Instagram, Github, Linkedin, Mail, Send, Zap } from 'lucide-react';
---

<footer id="contact" class="relative bg-background border-t-brutal-thick overflow-hidden">
  {/* Mathematical Grid Background */}
  <div class="absolute inset-0 bg-grid-math opacity-40"></div>

  {/* Decorative Mathematical Elements */}
  <div class="absolute top-10 left-10 w-20 h-20 border-brutal bg-primary/10 hidden lg:block"></div>
  <div class="absolute bottom-10 right-10 w-32 h-32 border-brutal-thick bg-accent/10 hidden lg:block"></div>
  <div class="absolute top-1/2 right-1/4 w-16 h-16 border-brutal bg-secondary/10 hidden xl:block"></div>

  <div class="relative container mx-auto px-6 sm:px-8 lg:px-12 py-20">
    <div class="max-w-7xl mx-auto">

      {/* Main Content Grid */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mb-16">

        {/* Left - Branding & Social */}
        <div class="space-y-8">
          {/* Logo & Tagline */}
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-foreground border-brutal shadow-brutal flex items-center justify-center p-3">
                <img src="/arieslogo.svg" alt="Aries Logo" class="w-full h-full invert" />
              </div>
              <div>
                <h3 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-foreground">ARIES</h3>
                <p class="text-sm font-bold uppercase tracking-tight text-muted-foreground">AI Society • IIT Delhi</p>
              </div>
            </div>

            <div class="bg-primary/10 border-brutal shadow-brutal px-6 py-4 max-w-md">
              <p class="text-sm md:text-base font-bold uppercase tracking-tight leading-relaxed">
                Building the future of artificial intelligence, one innovation at a time.
              </p>
            </div>
          </div>

          {/* Social Links */}
          <div class="space-y-4">
            <h4 class="text-lg font-black uppercase tracking-tight text-foreground border-l-8 border-l-primary pl-4">
              Connect With Us
            </h4>
            <div class="flex flex-wrap gap-3">
              <a
                href="https://www.instagram.com/aries.iitd"
                target="_blank"
                rel="noopener noreferrer"
                class="w-14 h-14 bg-primary text-primary-foreground border-brutal shadow-brutal hover-lift flex items-center justify-center transition-all duration-200"
                aria-label="Instagram"
              >
                <Instagram class="w-6 h-6" />
              </a>

              <a
                href="https://chat.whatsapp.com/D98xdCtosjr2d8wchQJSvL"
                target="_blank"
                rel="noopener noreferrer"
                class="w-14 h-14 bg-secondary text-secondary-foreground border-brutal shadow-brutal hover-lift flex items-center justify-center transition-all duration-200"
                aria-label="WhatsApp"
              >
                <Send class="w-6 h-6" />
              </a>

              <a
                href="https://github.com/Aries-IITD"
                target="_blank"
                rel="noopener noreferrer"
                class="w-14 h-14 bg-card text-foreground border-brutal shadow-brutal hover-lift flex items-center justify-center transition-all duration-200"
                aria-label="GitHub"
              >
                <Github class="w-6 h-6" />
              </a>

              <a
                href="https://www.linkedin.com/company/aries-artificial-intelligence-society-iitd"
                target="_blank"
                rel="noopener noreferrer"
                class="w-14 h-14 bg-accent text-accent-foreground border-brutal shadow-brutal hover-lift flex items-center justify-center transition-all duration-200"
                aria-label="LinkedIn"
              >
                <Linkedin class="w-6 h-6" />
              </a>

              <a
                href="mailto:aries@iitd.ac.in"
                class="w-14 h-14 bg-foreground text-background border-brutal shadow-brutal hover-lift flex items-center justify-center transition-all duration-200"
                aria-label="Email"
              >
                <Mail class="w-6 h-6" />
              </a>
            </div>
          </div>
        </div>

        {/* Right - Newsletter & Quick Links */}
        <div class="space-y-8">
          {/* Newsletter */}
          <div class="bg-accent/10 border-brutal-thick shadow-brutal-lg p-8 space-y-6">
            <div class="relative">
              <h4 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-foreground">
                Stay Updated
              </h4>
              <Zap class="absolute -top-4 -right-4 w-12 h-12 text-accent" />
            </div>

            <p class="text-sm font-bold uppercase tracking-tight">
              Get the latest on events, workshops, and AI breakthroughs.
            </p>

            <form class="space-y-4">
              <input
                type="email"
                placeholder="YOUR@EMAIL.COM"
                class="w-full px-6 py-4 bg-card border-brutal shadow-brutal text-foreground placeholder-muted-foreground font-bold uppercase text-sm focus:outline-none focus:shadow-brutal-lg transition-all duration-200"
                required
              />
              <button
                type="submit"
                class="w-full px-6 py-4 bg-primary text-primary-foreground font-black uppercase border-brutal shadow-brutal hover-lift hover:shadow-brutal-lg transition-all duration-200 flex items-center justify-center gap-2"
              >
                <Send class="w-5 h-5" />
                Subscribe
              </button>

              <p class="text-xs font-bold uppercase tracking-tight text-muted-foreground leading-relaxed">
                No spam. Unsubscribe anytime.
              </p>
            </form>
          </div>

          {/* Quick Links */}
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-3">
              <h5 class="text-sm font-black uppercase tracking-tight text-primary">Explore</h5>
              <ul class="space-y-2 text-sm font-bold uppercase">
                <li><a href="/events" class="text-foreground hover:text-primary transition-colors">Events</a></li>
                <li><a href="/projects" class="text-foreground hover:text-primary transition-colors">Projects</a></li>
                <li><a href="/team" class="text-foreground hover:text-primary transition-colors">Team</a></li>
                <li><a href="/gallery" class="text-foreground hover:text-primary transition-colors">Gallery</a></li>
              </ul>
            </div>

            <div class="space-y-3">
              <h5 class="text-sm font-black uppercase tracking-tight text-accent">Resources</h5>
              <ul class="space-y-2 text-sm font-bold uppercase">
                <li><a href="/legacy" class="text-foreground hover:text-accent transition-colors">Legacy</a></li>
                <li><a href="https://github.com/Aries-IITD" class="text-foreground hover:text-accent transition-colors">GitHub</a></li>
                <li><a href="mailto:aries@iitd.ac.in" class="text-foreground hover:text-accent transition-colors">Contact</a></li>
              </ul>
            </div>
          </div>
        </div>

      </div>

      {/* Bottom Bar */}
      <div class="pt-8 border-t-brutal space-y-4">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-sm font-bold uppercase tracking-tight text-muted-foreground text-center md:text-left">
            © {new Date().getFullYear()} Aries • IIT Delhi • All Rights Reserved
          </p>

          <div class="flex gap-4 text-xs font-bold uppercase">
            <a href="#" class="text-muted-foreground hover:text-foreground transition-colors">Privacy</a>
            <span class="text-muted-foreground">•</span>
            <a href="#" class="text-muted-foreground hover:text-foreground transition-colors">Terms</a>
            <span class="text-muted-foreground">•</span>
            <a href="#" class="text-muted-foreground hover:text-foreground transition-colors">Code of Conduct</a>
          </div>
        </div>

        <div class="text-center">
          <p class="text-xs font-black uppercase tracking-wide bg-primary/10 border-brutal inline-block px-6 py-2">
            Made with AI • For AI • By AI Enthusiasts
          </p>
        </div>
      </div>

    </div>
  </div>
</footer>

<style>
  /* Ensure Astro icons render properly */
  footer a svg {
    display: inline-block;
  }
</style>
